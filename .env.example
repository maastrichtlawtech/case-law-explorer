# ==============================================================================
# Case Law Explorer - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to version control - it contains sensitive credentials
# ==============================================================================

# ------------------------------------------------------------------------------
# Airflow Configuration
# ------------------------------------------------------------------------------
AIRFLOW_UID=1000
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# ------------------------------------------------------------------------------
# Postgres (cle_v2) Configuration -- issue #42
# ------------------------------------------------------------------------------
# Case metadata, full text, and citations all target this schema now (replaces
# the old DynamoDB tables + S3 buckets). Set up as an Airflow connection named
# `pg_cle` (airflow connections add pg_cle --conn-type postgres --conn-host ...),
# same pattern as the existing `pg_lido` connection used by airflow/dags/lido/.
# See db/README.md for the schema itself.

# ------------------------------------------------------------------------------
# legal-summarizer-service Configuration -- segmentation + summarization DAGs
# ------------------------------------------------------------------------------
SEGMENTATION_API_URL=http://legal-summarizer-service/segment
SUMMARIZATION_API_URL=http://legal-summarizer-service/summarize
SUMMARIZATION_MODEL=segment-based:default

# ------------------------------------------------------------------------------
# LIDO API Configuration
# ------------------------------------------------------------------------------
LIDO_ENDPOINT=http://linkeddata.overheid.nl/service/get-links
LIDO_USERNAME=your-lido-username-here
LIDO_PASSWORD=your-lido-password-here

# ------------------------------------------------------------------------------
# EUR-Lex Configuration
# ------------------------------------------------------------------------------
EURLEX_WEBSERVICE_USERNAME=your-eurlex-username-here
EURLEX_WEBSERVICE_PASSWORD=your-eurlex-password-here
CELEX_SUBSTITUTE=cIdHere
EURLEX_SUMMARY_LINK_INF=https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:cIdHere&from=EN
EURLEX_SUMMARY_LINK=https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:cIdHere_SUM&from=EN
EURLEX_SUMJURE_LINK=https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=URISERV:cIdHere_SUMJURE&from=EN
EURLEX_ALL_DATA=https://eur-lex.europa.eu/legal-content/EN/ALL/?uri=CELEX:cIdHere
EURLEX_FULL_TEXT=https://eur-lex.europa.eu/legal-content/EN/TXT/HTML/?uri=CELEX:cIdHere&from=EN

# ------------------------------------------------------------------------------
# ETL Configuration
# ------------------------------------------------------------------------------
# These back the *_etl DAGs' Airflow Variables (RS_START_DATE etc.) as a
# fallback default -- see Variable.get(..., default_var=os.getenv(...)) in
# rechtspraak_etl.py / echr_etl.py / cellar_etl.py. Loaded into every Airflow
# container via docker-compose's env_file, no `airflow variables set` needed.
RS_START_DATE="2023-01-01"
RS_END_DATE="2023-12-31"
RS_AMOUNT_TO_EXTRACT="1000"
CELLAR_START_DATE="2023-01-01"
CELLAR_END_DATE="2023-12-31"
CELLAR_AMOUNT_TO_EXTRACT="1000"
ECHR_START_DATE="2023-01-01"
ECHR_END_DATE="2023-12-31"
ECHR_AMOUNT_TO_EXTRACT="1000"
DATA_PATH="/opt/airflow/data"
URL_RS_ARCHIVE=http://static.rechtspraak.nl/PI/OpenDataUitspraken.zip
RS_SETUP=True
